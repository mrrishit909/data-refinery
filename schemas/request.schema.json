{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "request.schema.json",
  "title": "Data Refinery pipeline run parameters",
  "type": "object",
  "additionalProperties": false,
  "required": ["batches", "contract", "repair_mode", "fx_table"],
  "properties": {
    "batches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["2026-01", "2026-02", "2026-03", "2026-04"]}
    },
    "contract": {"const": "orders.v1"},
    "repair_mode": {"enum": ["propose", "apply-safe"]},
    "fx_table": {"const": "fixed-2026q1"}
  }
}
