{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run.schema.json",
  "title": "Run record (one per attempt, immutable once terminal)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id", "project", "request_id", "workflow_run_id", "source_commit", "input_manifest_hash",
    "schema_version", "created_at", "started_at", "completed_at", "status", "attempt", "parent_run_id",
    "result_paths", "evidence_paths", "error_summary", "resource_usage_summary", "request_source"
  ],
  "properties": {
    "run_id": {"type": "string", "pattern": "^[a-z0-9-]+-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}-a[0-9]+$"},
    "project": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "request_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "workflow_run_id": {"type": ["integer", "null"]},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "input_manifest_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "schema_version": {"const": "1.0"},
    "created_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {"enum": ["queued", "running", "completed", "failed", "blocked", "cancelled"]},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 10},
    "parent_run_id": {"type": ["string", "null"]},
    "result_paths": {"type": "array", "items": {"type": "string", "pattern": "^runs/[^.][^\\s]*$"}},
    "evidence_paths": {"type": "array", "items": {"type": "string"}},
    "error_summary": {"type": ["string", "null"], "maxLength": 2000},
    "resource_usage_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_seconds", "output_bytes", "inference"],
      "properties": {
        "wall_seconds": {"type": ["number", "null"], "minimum": 0},
        "output_bytes": {"type": ["integer", "null"], "minimum": 0},
        "inference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["used", "usd"],
          "properties": {"used": {"type": "boolean"}, "usd": {"type": ["number", "null"], "minimum": 0}}
        }
      }
    },
    "request_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "issue_number", "actor"],
      "properties": {
        "type": {"enum": ["issue", "schedule", "manual", "reconcile"]},
        "issue_number": {"type": ["integer", "null"]},
        "actor": {"type": ["string", "null"], "maxLength": 100}
      }
    }
  }
}
