{
  "contract": {
    "columns": [
      {
        "name": "order_id",
        "pattern": "^ORD-[0-9]{6}$",
        "required": true,
        "type": "string",
        "unique": true
      },
      {
        "name": "customer_id",
        "pattern": "^CUS-[0-9]{5}$",
        "required": true,
        "type": "string"
      },
      {
        "alternate_formats": [
          "%d/%m/%Y",
          "%m/%d/%Y"
        ],
        "format": "%Y-%m-%d",
        "name": "order_date",
        "note": "Canonical ISO date with a year in year_range. alternate_formats are the only candidates the drift detector may propose as repairs.",
        "required": true,
        "type": "date",
        "year_range": [
          2000,
          2099
        ]
      },
      {
        "min": "0",
        "name": "amount",
        "note": "Amount in the row's own currency. Values written with more than 2 decimal places (even trailing zeros) or more than 15 integer digits are rejected, never rounded.",
        "required": true,
        "scale": 2,
        "type": "decimal"
      },
      {
        "name": "currency",
        "required": true,
        "type": "enum",
        "values": [
          "USD",
          "EUR",
          "GBP"
        ]
      },
      {
        "name": "category",
        "required": true,
        "type": "enum",
        "values": [
          "Electronics",
          "Home",
          "Grocery",
          "Apparel",
          "Toys"
        ]
      },
      {
        "min": "1",
        "name": "quantity",
        "required": true,
        "type": "integer"
      },
      {
        "exclusive_min": "0",
        "name": "weight_kg",
        "note": "reference is the declared expected distribution, used for unit-scale drift only when no earlier accepted batch is available.",
        "reference": {
          "median": 2.03,
          "p05": 0.29,
          "p95": 20.6
        },
        "required": false,
        "scale": 3,
        "type": "float",
        "unit": "kg",
        "unit_conversions": {
          "g": "0.001"
        }
      },
      {
        "name": "region",
        "required": true,
        "type": "enum",
        "values": [
          "North",
          "South",
          "East",
          "West"
        ]
      }
    ],
    "contract": "orders.v1",
    "derived": [
      {
        "fx_table": "fixed-2026q1",
        "inputs": [
          "amount",
          "currency"
        ],
        "name": "amount_usd",
        "rule": "amount * rate[currency] rounded to 2 decimal places with the FX table's declared rounding mode",
        "scale": 2,
        "type": "decimal"
      }
    ],
    "description": "Synthetic e-commerce orders, one row per order. All data governed by this contract is generated by datarefinery.fixtures.",
    "entity": "orders",
    "primary_key": "order_id"
  },
  "fx": {
    "base_currency": "USD",
    "fx_table": "fixed-2026q1",
    "note": "Synthetic fixed rates chosen for demonstration. Not market data and not tied to any real date.",
    "rates": {
      "EUR": "1.08",
      "GBP": "1.27",
      "USD": "1.00"
    },
    "rounding": "ROUND_HALF_UP",
    "scale": 2,
    "synthetic": true
  }
}
